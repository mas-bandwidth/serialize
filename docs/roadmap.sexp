; The serialize family roadmap: the data ROADMAP.md is generated from, in the shape of
; mas-bandwidth/serialize.moo's, moo's and schema's docs/roadmap.sexp (one restricted
; S-expression; data, never evaluated). ROADMAP.md is rendered by tools/roadmap/render.lisp
; (vendored from mas-bandwidth/serialize.moo): edit this file, then
; `make -f tools/roadmap/roadmap.mk roadmap`; its roadmap-check target fails when the committed
; page is not what this data renders. Never edit
; ROADMAP.md by hand.
;
; Columns are the reference (this repo) and its fourteen ports. A cell is ✅ only when every task
; under it is :done, and a :done task names its evidence (a test or a release tag). A ❌ cell's
; reason is its task's :note. Port cells were set on 2026-10-27 from each port's latest release.
(:schema 1 :root "serialize/roadmap"
 :page (:title "serialize family roadmap"
        :roadmaps ("uniform" "security" "honesty" "speed" "release")
        :closing ((:title "The bar" :text ("When every cell is ✅, the family is uniform, audited, honestly tested and fast. That is the bar."))
                  (:title "About this page" :text ("Each row is one piece of work across the C++ reference and its fourteen ports. ✅ is done, with the test or release tag that proves it in the source data, or not applicable to that column, said in the source data. ❌ is not yet, with the reason in the source data."))))
 :nodes
 ((:id "serialize/roadmap" :type :work-set :children ("uniform" "security" "honesty" "speed" "release"))
  (:id "uniform" :type :roadmap :title "Uniform: every port keeps the 2.1 standard"
   :text ("IMPLEMENTING.md's U1 to U16 and the 2.1 corpus, in every port. A port cell is ✅ only when the port is released at 2.1.0 or later (Rust: 3.2.0) and its main carries the rule with a test. On 2026-10-27 no port had reached that release; the 2.1 port wave is landing it.")
   :rows
   (("revendor" "Re-vendored at the v2.1.0 corpus (413 vectors)")
    ("u2" "U2. A caller's refusal latches rejected")
    ("u1" "U1. Write buffers are a multiple of 8 bytes")
    ("u3" "U3. A writer never sends bytes that differ from the caller's value")
    ("u4" "U4. UTF-8 and NUL are checked on string write")
    ("u5" "U5. int bounds are int32")
    ("u6" "U6. A measure stream refuses nothing")
    ("u7" "U7. A reader never traps, and a refusal is a value")
    ("u8" "U8. Over-wide values on write are caught in the checked build")
    ("u9" "U9. One write-misuse mechanism per implementation")
    ("u10" "U10. A write checks room for the whole operation before writing any of it")
    ("u11" "U11. A writer's buffer is unspecified until flush")
    ("u12" "U12. end on a write or measure stream is a no-op returning true")
    ("u13" "U13. Re-initialising a stream is optional")
    ("u14" "U14. The refusal-name function, and a public fail")
    ("u15" "U15. The allowed extras, and the language necessities (copy_string and compressed_float precomputed everywhere)")
    ("u16" "U16. Caller declarations are validated on every stream before any bits move")
    ("object" "A public object composition")
    ("sabotage" "A sabotage control for every .expected list"))
   :columns (("cpp" "C++") ("c" "C") ("go" "Go") ("rs" "Rust") ("js" "JS") ("java" "Java") ("cs" "C#") ("dart" "Dart") ("elixir" "Elixir") ("lua" "Lua") ("luau" "Luau") ("nut" "Squirrel") ("goose" "Goose") ("lobster" "Lobster") ("moo" "moo"))
   :cells
   (("revendor" "cpp" "uniform/revendor/cpp")
    ("revendor" "c" "uniform/revendor/c")

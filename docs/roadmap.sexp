  (:id "uniform/sabotage/moo" :type :work-set :children ("uniform-sabotage-moo"))
  (:id "security" :type :roadmap :title "Security: the audit's findings"
   :text ("Every finding of medium or above in AUDIT-LEDGER.md 2026-10-27 has a row, the three highs first, then the family class, then one row of low findings per implementation. A cell is ❌ until the fix and its red-first test are on main. A ✅ that reads 'not applicable' in the source data is a column the finding does not name. Reproducer paths are the audit's, named in the source data.")
   :rows
   (("h-dart-wasm" "High: dart2wasm float/double misdecode (shared typed-list views flip sNaN-shaped halves)")
    ("h-dart-int32" "High: Dart int bounds above int32 throw on wire bytes")
    ("h-goose-builder" "High: Goose limited-builder string trap (capacity vs buffer_size - 1 never checked)")
    ("class-bufsize" "Family class: string read with buffer_size < 1")
    ("m-cpp-bufsize" "Medium (C++): string read buffer_size <= 0 gave a wire-chosen heap overflow; min > max accepted; negative byte count reported none")
    ("m-cpp-narrowing" "Medium (C++): int64/int128 write asserts checked after narrowing")
    ("m-c-fixed-q" "Cited (C): fixed Q-format declaration not checked; Q16.16 [-40000, 40000] accepts +2^31")
    ("m-go-cf-doc" "Medium (Go): compressed_float doc promises [min, max]; decodes above max")
    ("m-go-precomputed" "Medium (Go): precomputed validator accepts underivable constants")
    ("m-js-overwide" "Medium (JS): checked build masks over-wide bits on write")
    ("m-java-bufsize" "Medium (Java): string read bufferSize < 1 throws NegativeArraySizeException")
    ("m-cs-batch" "Medium (C#): ReadBatch.Sync after End clears a latched refusal")
    ("m-dart-gate" "Medium (Dart): the web gate is blind to the dart2wasm misdecode")
    ("m-elixir-measure" "Medium (Elixir): MeasureStream checks nothing; negative measure from bytes(nil, -5)")
    ("m-lua-precomputed" "Medium (Lua): compressedFloat precomputed lacks the uint32 bound on maxIntegerValue")
    ("m-lua-overwide" "Medium (Lua): serializeBits writes an over-wide value masked, no raise")
    ("m-luau-bits" "Medium (Luau): a non-integer bits parameter is accepted")
    ("m-nut-overflow" "Medium (Squirrel): signed 64-bit overflow in int64/int128/fixed/bits math, wire-driven for int128")
    ("m-goose-fixed" "Medium (Goose): fixed min/max outside the Q format not checked")
    ("low-cpp" "Low findings: C++")
    ("low-c" "Low findings: C")
    ("low-go" "Low findings: Go")
    ("low-rs" "Low findings: Rust")
    ("low-js" "Low findings: JS")
    ("low-java" "Low findings: Java")
    ("low-cs" "Low findings: C#")
    ("low-dart" "Low findings: Dart")
    ("low-elixir" "Low findings: Elixir")
    ("low-lua" "Low findings: Lua")
    ("low-luau" "Low findings: Luau")
    ("low-nut" "Low findings: Squirrel")
    ("low-goose" "Low findings: Goose")
    ("low-lobster" "Low findings: Lobster")
    ("low-moo" "Low findings: moo"))
   :columns (("cpp" "C++") ("c" "C") ("go" "Go") ("rs" "Rust") ("js" "JS") ("java" "Java") ("cs" "C#") ("dart" "Dart") ("elixir" "Elixir") ("lua" "Lua") ("luau" "Luau") ("nut" "Squirrel") ("goose" "Goose") ("lobster" "Lobster") ("moo" "moo"))
   :cells
   (("h-dart-wasm" "cpp" "security/h-dart-wasm/cpp")
    ("h-dart-wasm" "c" "security/h-dart-wasm/c")
    ("h-dart-wasm" "go" "security/h-dart-wasm/go")
